# Copiá este archivo a .env.local y completá los valores. NUNCA subas .env.local ni valores reales.
# En Vercel se cargan en Settings > Environment Variables.

# ---------------------------------------------------------------------------
# Base de datos (Neon)
# Se cargan solas al conectar Neon desde el Marketplace de Vercel
# (o con `vercel env pull .env.local`). Formato: postgresql://usuario:clave@host/base?sslmode=require
# ---------------------------------------------------------------------------

# Conexión CON pooling. La usa la app en tiempo de ejecución. Obligatoria.
DATABASE_URL=

# Conexión DIRECTA (sin pooling). La usa drizzle-kit para las migraciones (npm run db:migrate).
# Opcional: si falta, las migraciones usan DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Dueño de la app
# ---------------------------------------------------------------------------

# Usuario del DUEÑO. Obligatorio, no hay valor por defecto.
# Es el único que crea y borra usuarios y maneja los respaldos (/admin/usuarios y /admin/respaldo).
ADMIN_USER=

# Contraseña del DUEÑO. Obligatoria. Elegí una larga y única.
# Vive solo acá (no en la base): para cambiarla, editá la variable y volvé a desplegar.
# Al cambiarla se cierran todas las sesiones del dueño.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Sesión
# ---------------------------------------------------------------------------

# Secreto para firmar la cookie de sesión. Obligatorio.
# Al menos 32 caracteres en producción. Generalo con:  openssl rand -base64 48
# Si lo cambiás se cierran todas las sesiones. No lo reutilices en otros proyectos.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Solo para los tests e2e (opcionales; ver e2e/README.md)
# Los e2e ESCRIBEN datos: apuntalos a una rama de Neon o a una base de prueba, nunca a producción.
# ---------------------------------------------------------------------------
# E2E_ALLOW_WRITES=1
# E2E_URL=http://localhost:3100
# E2E_USER=      # igual a ADMIN_USER del servidor que levantes para probar
# E2E_PASS=      # igual a ADMIN_PASSWORD de ese servidor
