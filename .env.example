# Base de datos Neon (se cargan solas al conectar Neon desde el Marketplace de Vercel)
# DATABASE_URL: conexión con pooling, la usa la app.
# DATABASE_URL_UNPOOLED: conexión directa, la usa drizzle-kit para las migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Credenciales del panel de admin (obligatorias, no hay valores por defecto).
ADMIN_USER=
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión (obligatorio).
# Generar uno con: openssl rand -base64 32
SESSION_SECRET=
